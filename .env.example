# QuantRadar 环境变量示例（复制为 .env 并按需修改；.env 已被 .gitignore 忽略）
# 仅包含 InvestmentDataProvider 的只读连接配置。
# 所有 INVESTMENT_DATA_* 变量由 QuantRadar 自管，不写入 BulletTrade 的 env_loader.py。

# investment_data（Dolt SQL server，只读）连接
INVESTMENT_DATA_HOST=127.0.0.1
INVESTMENT_DATA_PORT=3307
INVESTMENT_DATA_USER=root
INVESTMENT_DATA_PASSWORD=
INVESTMENT_DATA_DATABASE=investment_data

# 连接超时（秒）
INVESTMENT_DATA_CONNECT_TIMEOUT=5.0
INVESTMENT_DATA_READ_TIMEOUT=30.0

# 注意：
#   - 禁止写入真实密码到仓库；生产环境通过独立 .env 或密钥管理提供。
#   - investment_data 为只读事实源，Provider 不执行任何写操作。
#   - 不要依赖 DEFAULT_DATA_PROVIDER=investment_data 让 BulletTrade import 阶段自动注册；
#     QuantRadar 应在 bootstrap 阶段显式 register_data_provider + set_data_provider。

# PostgreSQL（异步回测 Worker 落库；未设置时 /api/backtest/async 等返回 503）
# 格式：postgresql+psycopg2://<user>:<password>@<host>:<port>/<db>
# 本机 1Panel PostgreSQL 默认端口 5432；例如本机已存在 KenRadar 库/用户：
# QUANT_RADAR_PG_URL=postgresql+psycopg2://KenRadar:你的密码@127.0.0.1:5432/KenRadar
# 注意：含特殊字符的密码需按 URL 编码（@ -> %40，: -> %3A，/ -> %2F）。
QUANT_RADAR_PG_URL=

# Research MVP（所有路径必须是 Git 工作区之外的绝对路径；不要提交 Cookie、PDF、Markdown、Key 或 Webhook）
QUANTRADAR_RESEARCH_DATABASE_URL=
QUANTRADAR_RESEARCH_DATA_DIR=/data/quantradar/research
QUANTRADAR_QYJ_PROFILE_DIR=/data/quantradar/qyj-profile
QUANTRADAR_MINERU_API_URL=http://127.0.0.1:58000
QUANTRADAR_MINERU_TIMEOUT_SECONDS=1800
QUANTRADAR_AGNES_API_KEY=
QUANTRADAR_AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
QUANTRADAR_AGNES_MODEL=agnes-2.5-flash
QUANTRADAR_AGNES_MAX_INPUT_TOKENS=12000
QUANTRADAR_AGNES_RPM=19
QUANTRADAR_FEISHU_WEBHOOK_URL=
QUANTRADAR_FEISHU_REQUIRED_KEYWORD=
