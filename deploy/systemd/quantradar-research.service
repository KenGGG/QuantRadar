[Unit]
Description=QuantRadar Enterprise Alert Research daily pipeline

[Service]
Type=oneshot
WorkingDirectory=/data/Projects/a-stock-research/QuantRadar
Environment=PYTHONPATH=backend
ExecStart=/bin/bash -lc 'day=$(/bin/date -I -d yesterday); .venv/bin/python -m quantradar.research.cli pipeline --date "$day" && .venv/bin/python -m quantradar.research.cli deliver --date "$day"'

