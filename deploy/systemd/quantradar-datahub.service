[Unit]
Description=QuantRadar DataHub staged update
After=network-online.target
Wants=network-online.target
Requires=quantradar-datahub-dolt.service
After=quantradar-datahub-dolt.service

[Service]
Type=oneshot
WorkingDirectory=/data/Projects/a-stock-research/QuantRadar
EnvironmentFile=-/data/quantradar_data/datahub.env
Environment=PYTHONPATH=/data/Projects/a-stock-research/QuantRadar/backend
ExecStart=/data/Projects/a-stock-research/QuantRadar/.venv/bin/python -m quantradar.datahub.cli update-all --wait
TimeoutStartSec=infinity
